# Copy to .env.local and fill in. Local values come from `npx supabase status`.
# Keep .env.local pointed at the local stack: `next dev` and the operator
# scripts (npm run user:create, npm run foods:import-argenfoods) read it.

# Browser-safe (inlined into the client bundle).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server/scripts only. NEVER prefix with NEXT_PUBLIC_.
# Locally: the "Secret" key printed by `npx supabase status`.
SUPABASE_SERVICE_ROLE_KEY=

# Production (Vercel project settings): only the two NEXT_PUBLIC_ variables.
# Never add SUPABASE_SERVICE_ROLE_KEY or EXPOSE_TESTING_API there.
#
# To run the operator scripts against the hosted project, put
# NEXT_PUBLIC_SUPABASE_URL and its secret key in a separate gitignored file
# (e.g. .env.production.local), run
# `node --env-file=.env.production.local scripts/<script>.mjs`,
# and delete the file afterwards.