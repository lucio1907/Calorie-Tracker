# Copy to .env.local and fill in. Local values come from `npx supabase status`.

# Browser-safe (inlined into the client bundle).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server/scripts only. NEVER prefix with NEXT_PUBLIC_.
# Locally: the "Secret" key printed by `npx supabase status`.
SUPABASE_SERVICE_ROLE_KEY=
