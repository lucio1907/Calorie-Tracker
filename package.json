{
  "name": "contador-calorias",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "EXPOSE_TESTING_API=1 playwright test",
    "test:e2e:ui": "EXPOSE_TESTING_API=1 playwright test --ui",
    "db:start": "node scripts/supabase-start.mjs",
    "user:create": "node --env-file-if-exists=.env.local scripts/create-user.mjs",
    "foods:import-argenfoods": "node --env-file-if-exists=.env.local scripts/import-argenfoods.mjs",
    "audit:all": "node scripts/audit-all.mjs"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "barcode-detector": "3.2.3",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/playwright": "16.4.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
